{
  "name": "soccermon",
  "private": true,
  "version": "0.8.7",
  "author": "Miguel Cunha (https://github.com/miguel20br)",
  "description": "Fan game sem fins lucrativos: draft de Pokémon Gen 1 + futsal 5v5 simulado.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite/config.dev.mjs",
    "build": "tsc --noEmit && vite build --config vite/config.prod.mjs",
    "preview": "vite preview --config vite/config.prod.mjs",
    "test": "vitest run",
    "lint": "biome check src scripts",
    "format": "biome format --write src scripts",
    "data": "tsx scripts/build-data.ts",
    "assets:cards": "tsx scripts/fetch-sprites.ts",
    "assets:field": "tsx scripts/build-pmd-atlas.ts",
    "assets:audio": "tsx scripts/fetch-audio.ts",
    "assets:items": "tsx scripts/fetch-items.ts",
    "assets:types": "tsx scripts/fetch-type-icons.ts",
    "assets:portraits": "tsx scripts/fetch-portraits.ts",
    "changelog": "tsx scripts/changelog.ts",
    "fonts": "tsx scripts/build-fonts.ts",
    "calibrate": "tsx scripts/calibrate.ts",
    "stats": "tsx scripts/stats.ts",
    "determinismo": "tsx scripts/determinismo.ts",
    "edge:liga": "esbuild src/league/edge-entry.ts --bundle --minify --format=esm --platform=neutral --outfile=supabase/functions/liga/engine.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "galmuri": "^2.40.3",
    "idb-keyval": "^6.3.0",
    "motion": "^14.2.0",
    "phaser": "^4.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15",
    "zzfx": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@pkmn/data": "^0.10.11",
    "@pkmn/dex": "^0.10.11",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fast-xml-parser": "^5.11.2",
    "pg": "^8.23.1",
    "puppeteer-core": "^25.14.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
