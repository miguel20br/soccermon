{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": "vite",
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "redirects": [
        { "source": "/tt", "destination": "/?utm_source=tiktok", "permanent": false },
        { "source": "/yt", "destination": "/?utm_source=youtube", "permanent": false },
        { "source": "/ig", "destination": "/?utm_source=instagram", "permanent": false },
        { "source": "/privacidade", "destination": "/privacidade.html", "permanent": true },
        { "source": "/privacy", "destination": "/privacy.html", "permanent": true }
    ],
    "headers": [
        {
            "source": "/bundle/(.*)",
            "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        },
        {
            "source": "/assets/(.*)",
            "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
        },
        {
            "source": "/music/(.*)",
            "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
        },
        {
            "source": "/(.*)",
            "headers": [
                { "key": "X-Content-Type-Options", "value": "nosniff" },
                { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
                { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
                { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
            ]
        }
    ]
}
