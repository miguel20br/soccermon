# Opcional: login com Google e save na nuvem (Supabase). Sem estas variáveis o jogo roda 100% local.
# Use só as chaves PÚBLICAS do projeto (URL + publishable/anon key). Nunca coloque aqui a service_role
# nem a secret key: tudo com prefixo VITE_ ou NEXT_PUBLIC_ vai para o navegador.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
